          },
          {
            "id": "not_an_eraser",
            "name": "Alfa cero",
            "operations": [
              {"id": "ghost_cover", "type": "rect", "box": [0, 0, 3, 2], "color": "ghost"}
            ]
          },
          {
            "id": "zero_opacity",
            "name": "Opacidad cero",
            "opacity": 0,
            "operations": [
              {"id": "muted_cover", "type": "rect", "box": [0, 0, 3, 2], "color": "solid"}
            ]
          },
          {
            "id": "hidden",
            "name": "Oculta",
            "visible": false,
            "operations": [
              {"id": "hidden_cover", "type": "rect", "box": [0, 0, 3, 2], "color": "solid"}
            ]
          },
          {
            "id": "faint_layer",
            "name": "Alfa uno",
            "operations": [
              {"id": "whisper", "type": "pixel", "at": [2, 1], "color": "faint"}
            ]
          },
          {
            "id": "vanishing",
            "name": "Se redondea a cero",
            "opacity": 1,
            "operations": [
              {"id": "lost_whisper", "type": "pixel", "at": [1, 1], "color": "faint"}
            ]
          }
        ]
      }
    },
    "clipping": {
      "kind": "document",
