                "opacity": 200,
                "children": [
                  {
                    "kind": "layer",
                    "id": "spark",
                    "fills": [{"type": "pixel", "at": [3, 1], "rgba": "#FFFFFFFF"}]
                  },
                  {
                    "kind": "layer",
                    "id": "ghost",
                    "visible": false,
                    "fills": [{"type": "rect", "box": [0, 0, 4, 2], "rgba": "#FF0000FF"}]
