          "id": "pal",
          "colors": [
            {"id": "solid", "rgba": "#3366CCFF"},
            {"id": "ghost", "rgba": "#FF00FF00"},
            {"id": "faint", "rgba": "#FF804001"},
            {"id": "half", "rgba": "#20406080"}
          ]
        },
        "layers": [
          {
            "id": "base",
            "name": "Base",
            "operations": [
              {"id": "block", "type": "rect", "box": [0, 0, 2, 1], "color": "solid"},
              {"id": "glaze", "type": "pixel", "at": [2, 0], "color": "half"}
