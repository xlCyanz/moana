{
  "format": "moanart-determinism-corpus/1",
  "cases": {
    "diagonals": {
      "kind": "document",
      "document": {
        "schema_version": "1.0",
        "id": "diagonals",
        "canvas": {"width": 8, "height": 6, "profile": "strict"},
        "palette": {
          "id": "pal",
          "colors": [
            {"id": "clear", "rgba": "#00000000"},
            {"id": "ink", "rgba": "#102030FF"},
            {"id": "gold", "rgba": "#FAC800FF"},
            {"id": "sea", "rgba": "#1E5A8CFF"},
            {"id": "rose", "rgba": "#C83C5AFF"}
          ]
        },
        "layers": [
          {
            "id": "lines",
            "name": "Diagonales",
            "operations": [
              {"id": "main", "type": "line", "start": [-2, -2], "end": [7, 7], "color": "ink"},
              {"id": "anti", "type": "line", "start": [5, 0], "end": [0, 5], "color": "gold"},
              {"id": "shallow", "type": "line", "start": [7, 4], "end": [4, 5], "color": "sea"},
              {"id": "tie", "type": "line", "start": [7, 2], "end": [5, 1], "color": "rose"}
            ]
          }
        ]
      }
    },
    "alpha": {
      "kind": "document",
      "document": {
        "schema_version": "1.0",
        "id": "alpha",
        "canvas": {"width": 4, "height": 3, "profile": "rgba"},
        "palette": {
          "id": "pal",
          "colors": [
            {"id": "red", "rgba": "#FF000080"},
            {"id": "blue", "rgba": "#0000FF80"},
            {"id": "white", "rgba": "#FFFFFFFF"},
            {"id": "green", "rgba": "#00FF00FF"}
          ]
        },
        "layers": [
          {
            "id": "base",
            "name": "Base",
            "operations": [
              {"id": "wash_red", "type": "rect", "box": [0, 0, 3, 2], "color": "red"},
              {"id": "wash_blue", "type": "rect", "box": [1, 0, 4, 3], "color": "blue"}
            ]
          },
          {
            "id": "top",
            "name": "Arriba",
            "opacity": 128,
            "operations": [
              {"id": "spark", "type": "pixel", "at": [2, 1], "color": "white"},
              {"id": "leaf", "type": "pixel", "at": [0, 2], "color": "green"}
            ]
          }
        ]
      }
    },
    "transparency": {
      "kind": "document",
      "document": {
