              },
              {"id": "moon", "type": "ellipse", "box": [3, 2, 9, 8], "color": "sea"},
              {"id": "beam", "type": "line", "start": [-10, 3], "end": [10, 3], "color": "rose"},
              {"id": "lost", "type": "pixel", "at": [7, 1], "color": "ink"},
              {"id": "beyond", "type": "rect", "box": [5, 0, 9, 4], "color": "gold"},
              {"id": "slope", "type": "line", "start": [-3, 0], "end": [4, 2], "color": "mint"}
            ]
          }
        ]
      }
    },
    "rounding": {
      "kind": "document",
      "document": {
        "schema_version": "1.0",
