    "Canvas": {
      "additionalProperties": false,
      "description": "Canvas size and colour profile (``strict`` or ``rgba``, MOANA.md section 9).",
      "properties": {
        "height": {
          "maximum": 2048,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "profile": {
          "default": "strict",
          "enum": [
            "strict",
            "rgba"
          ],
          "title": "Profile",
          "type": "string"
        },
        "width": {
          "maximum": 2048,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "Color": {
      "additionalProperties": false,
      "description": "A palette entry; ``rgba`` is ``#RRGGBBAA`` and is stored upper-case.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "rgba": {
          "pattern": "^#[0-9A-Fa-f]{8}$",
          "title": "Rgba",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rgba"
      ],
      "title": "Color",
      "type": "object"
    },
