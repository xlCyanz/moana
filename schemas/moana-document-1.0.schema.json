    "Layer": {
      "additionalProperties": false,
      "description": "Ordered operations drawn bottom-to-top; ``locked`` affects editing only.\n\n``mask_id`` (optional) clips the whole layer to a semantic mask (ADR-022).",
      "properties": {
        "blend": {
          "const": "normal",
          "default": "normal",
          "title": "Blend",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "mask_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Mask Id",
          "type": "string"
        },
        "name": {
          "maxLength": 4096,
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "default": 255,
          "maximum": 255,
          "minimum": 0,
          "title": "Opacity",
          "type": "integer"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "ellipse": "#/$defs/EllipseOperation",
                "line": "#/$defs/LineOperation",
                "path": "#/$defs/PathOperation",
                "pixel": "#/$defs/PixelOperation",
                "polygon": "#/$defs/PolygonOperation",
                "rect": "#/$defs/RectOperation"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PixelOperation"
              },
              {
                "$ref": "#/$defs/LineOperation"
              },
              {
                "$ref": "#/$defs/RectOperation"
              },
              {
                "$ref": "#/$defs/EllipseOperation"
              },
              {
                "$ref": "#/$defs/PolygonOperation"
              },
              {
                "$ref": "#/$defs/PathOperation"
              }
            ]
          },
          "maxItems": 10000,
          "title": "Operations",
          "type": "array"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "operations"
      ],
      "title": "Layer",
      "type": "object"
    },
